---
import Layout from "../layouts/Layout.astro"
import manifest from "../../public/__steer/api/manifest.json"

/**
 * The bench routes. They live in a catch-all because Astro treats any path
 * segment starting with an underscore as private, and the product's route
 * base is /__steer, which is contract, not configuration.
 */
export function getStaticPaths() {
  const components = (manifest as { components: { slug: string; name: string }[] }).components ?? []
  return [
    { params: { path: "__steer" }, props: { name: "Components" } },
    ...components.map((c) => ({ params: { path: `__steer/${c.slug}` }, props: { name: c.name } })),
  ]
}

const { name } = Astro.props
---

<Layout title={`${name}, steer-ui`}>
  <link rel="stylesheet" href="/__steer/chrome/bench.css" />
  <div id="steer-root"></div>

  {/*
    Two module graphs, exactly as in a real host. This script is compiled by the
    site (it needs the component glob and the static-API shim); the chrome below
    it is the prebuilt artifact, served and never compiled. Order matters only
    so the shim patches fetch before the chrome asks for anything; the
    registration itself is order-independent, the bridge queues it.
  */}
  <script>
    import "../lib/api-shim"
    import "../steer"
  </script>
  <script type="module" src="/__steer/chrome/bench.js"></script>
</Layout>
