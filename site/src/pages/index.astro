---
import Layout from "../layouts/Layout.astro"
import HeroCanvas from "../islands/HeroCanvas"
import PageNotes from "../islands/PageNotes"
import { CopyBox } from "../components/CopyBox"
// The logo mark is literally the cursor you get when adding a note. Rendered
// without a client directive, so it is static HTML and ships no JS.
import { GhostPin } from "../../../src/adapters/chrome/parts/GhostPin"
---

<Layout title="steer-ui, the visual interface for steering coding agents" fullscreen>
  <div class="relative h-[100dvh] w-full overflow-hidden">
    <HeroCanvas client:load />

    {/* White vignette: a halo behind the headline, a soft edge around everything. */}
    <div
      class="pointer-events-none absolute inset-0 z-20"
      style="background:
        radial-gradient(ellipse 30% 22% at 50% 48%, rgba(255,255,255,0.96) 0%, rgba(255,255,255,0.7) 55%, rgba(255,255,255,0) 100%),
        linear-gradient(to right, #ffffff 0%, rgba(255,255,255,0.92) 3%, rgba(255,255,255,0) 13%),
        linear-gradient(to left, #ffffff 0%, rgba(255,255,255,0.92) 3%, rgba(255,255,255,0) 13%),
        linear-gradient(to bottom, #ffffff 0%, rgba(255,255,255,0.9) 2%, rgba(255,255,255,0) 11%),
        linear-gradient(to top, #ffffff 0%, rgba(255,255,255,0.9) 2%, rgba(255,255,255,0) 11%);"
    >
    </div>

    {/* Bench and GitHub live in the peek now, so the nav is the mark alone. */}
    <nav class="absolute inset-x-0 top-0 z-30 flex items-center justify-center px-4 py-6 sm:px-8">
      <a href="/" class="flex items-center gap-2.5">
        <GhostPin />
        <span class="whitespace-nowrap font-mono text-[18px] font-medium tracking-tight text-zinc-900 sm:text-[23px]">steer-ui</span>
      </a>
    </nav>

    {/*
      A phone is one column and two rows: the copy, then the performance. Row
      two is the stage, and it is a real box — the bottom padding keeps it off
      the HUD, so its rect is the whole answer to where a note may go. Layering
      the copy over the canvas and floring the note by measurement was how the
      note ended up on the subhead.

      Display stays `grid` at every width, because `grid` and `flex` in one
      class list resolve by stylesheet order rather than by breakpoint. From sm
      up the rows collapse and the copy returns to the optical centre.
    */}
    <div class="pointer-events-none absolute inset-0 z-30 grid grid-rows-[auto_1fr] gap-y-4 px-6 pt-[76px] pb-[76px] sm:grid-rows-none sm:content-center sm:pt-0 sm:pb-0">
      <div data-hero-copy class="pointer-events-auto mx-auto w-full min-w-0 max-w-[580px] text-center">
        <h1
          data-steer="HeroTitle"
          class="text-[36px] font-semibold leading-[1.08] tracking-tight text-zinc-900 short:text-[28px] sm:text-[46px]"
        >
          The visual interface for steering coding agents
        </h1>
        <p data-steer="HeroSubhead" class="mx-auto mt-5 max-w-[490px] text-[17px] leading-relaxed text-zinc-600 short:mt-3 short:text-[14px]">
          Pin notes anywhere directly in your app. Your agent reads them as JSON in your repo, makes every change in one
          pass, and responds to your notes.
        </p>
        <div class="mt-7 flex justify-center max-sm:mt-5 short:mt-4">
          <CopyBox client:load />
        </div>
        <p class="mt-3 text-[14px] text-zinc-400 max-sm:hidden short:hidden">MIT. Runs in your dev server. Ships nothing to production.</p>
      </div>

      {/* Row two. Empty on purpose: the hero canvas lays its performance out
          inside this box, which only the grid knows the size of. */}
      <div data-hero-stage class="min-h-0 sm:hidden"></div>
    </div>

    <div class="absolute bottom-7 right-6 z-30 hidden text-[13px] text-zinc-400 lg:block sm:right-8">
      <a href="https://github.com/andresCamp/steer-ui" class="hover:text-zinc-700">github.com/andresCamp/steer-ui</a>
    </div>

    <PageNotes client:load />
  </div>
</Layout>
