{
  "name": "steer-ui",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "pnpm build:chrome && vite playground/app",
    "dev:react": "pnpm build:chrome && vite playground/react-app",
    "dev:anchor": "vite playground/anchor-lab",
    "test": "vitest run",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.react.json --noEmit && tsc -p tsconfig.lab.json --noEmit",
    "playground": "bun playground/run.ts",
    "build": "pnpm -C site install --frozen-lockfile && pnpm -C site run build",
    "deploy": "wrangler deploy",
    "build:chrome": "vite build --config vite.chrome.config.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@solidjs/router": "^0.15.3",
    "lucide-react": "^0.540.0",
    "lucide-solid": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.8.0",
    "solid-js": "^1.9.7",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.11.2",
    "svelte": "^5.56.9",
    "tailwindcss": "^4.1.11",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^3.2.4",
    "vue": "^3.5.41",
    "wrangler": "^4.123.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
