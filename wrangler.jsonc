{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steerui",
  "compatibility_date": "2026-08-13",
  // Assets-only Worker: the site is fully prerendered, so there is no
  // `main` script and therefore no ASSETS binding to declare.
  "assets": {
    "directory": "./site/dist"
  },
  "observability": { "enabled": true }
}
